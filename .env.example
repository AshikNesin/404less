# Copy to `.env` for local overrides. Every variable has a development default,
# so a fresh checkout boots with no .env at all. Production (NODE_ENV=production)
# requires the secrets marked [prod-required] — the server refuses to start
# with the development fallbacks. On Cloudflare set these as Worker secrets/vars.

NODE_ENV=development

# SQLite file for the Node runtime (Workers bind D1 instead). Unset: data/dev.db
# in development, /data/prod.db in production.
# DATABASE_URL=file:./data/dev.db
# Node only: uploads folder. Unset: ./local/uploads in development,
# /data/uploads (next to the database) in production.
# UPLOADS_DIR=./local/uploads
PORT=3000

# [prod-required] At least 32 characters.
JWT_SECRET_KEY=
# [prod-required] Header value for admin-only endpoints (X-Admin-Auth-Key).
ADMIN_AUTH_KEY=

# Passkeys (WebAuthn) relying party. [prod-required] RP_ID + ORIGIN must match
# your public domain, e.g. RP_ID=app.example.com ORIGIN=https://app.example.com
RP_NAME=404less
RP_ID=localhost
ORIGIN=http://localhost:3000

# Comma-separated allow-list. Empty allows the requesting origin.
CORS_ALLOWED_ORIGINS=
# trace | debug | info | warn | error | fatal | silent (default: debug in dev, info in prod)
LOG_LEVEL=

# Error tracking (optional), read through config.sentry. SENTRY_RELEASE must
# match the release the build uploaded source maps under.
SENTRY_DSN=
SENTRY_RELEASE=
# Build-time only (scripts/build.mjs, vite.config.ts): source map upload and
# the release name. Not validated at runtime.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=
SOURCE_COMMIT=

# AI (optional): Cloudflare AI Gateway and a default model, read by app code
# that builds an @groot/ai client.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
DEFAULT_MODEL=
# Provider keys are read by the provider SDKs straight from process.env when no
# apiKey is passed, so they are not in envSchema.
# OPENAI_API_KEY=

# Push notifications on server start (optional)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# --- 404less ---------------------------------------------------------------
# On Cloudflare these are Worker vars/secrets (wrangler.jsonc, `wrangler secret
# put`); on Node (`pnpm dev`) they are read from this file.
# Resend API key for sign-in links and email digests. Required for sign-in on
# a public host; unset, a local dev server (localhost) returns the link in the
# API response instead of emailing it.
# RESEND_API_KEY=
# Sender, e.g. "404less <no-reply@yourdomain>".
# MAIL_FROM=
# Sites per team (default 5) and days of raw 404 events kept (default 90, max 365).
# MAX_SITES_PER_TEAM=5
# EVENT_RETENTION_DAYS=90
