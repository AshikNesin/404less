# Environment Configuration
# Copy this file to .env and update values for your environment

# Application Environment
ENV=development
# Options: development, staging, production

# Database Configuration
# Production: Use secure passwords and proper hostnames
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name

# Application Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=9001

# Security Settings
# Production: Set a strong, random secret key
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=false

# CORS Configuration
# Production: Set specific allowed origins, comma-separated
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:9000

# Database Pool Settings (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Version Control (optional)
BACKEND_VERSION=
COMMIT_REF=

# PostgreSQL Settings (for local development with Docker)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=app
POSTGRES_PORT=5432
