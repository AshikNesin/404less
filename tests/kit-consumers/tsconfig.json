{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@groot/ui": ["../../packages/ui/src/index.ts"],
      "@groot/ui/*": ["../../packages/ui/src/*"],
      "@groot/shell/*": ["../../packages/shell/src/*"],
      "@groot/core/*": ["../../packages/core/src/*"],
      "@groot/jobs/lifecycle": ["../../packages/jobs/src/lifecycle.ts"],
      "@groot/jobs/client": ["../../packages/jobs/src/client/index.ts"],
      "@groot/jobs/client/*": ["../../packages/jobs/src/client/*"],
      "@groot/jobs/server": ["../../packages/jobs/src/server/index.ts"],
      "@groot/jobs/server/*": ["../../packages/jobs/src/server/*"],
      "@groot/ai": ["../../packages/ai/src/index.ts"],
      "@groot/ai/*": ["../../packages/ai/src/*"]
    }
  },
  "include": ["./consumer.tsx"]
}
