# Environment Configuration
# Copy this file to .env and update values for your environment

# Application Environment
ENV=development
# Options: development, production

# === REQUIRED SETTINGS ===
# These MUST be set for the application to start

# Database Configuration (REQUIRED)
# Development: postgresql+psycopg://dev:dev@localhost:5432/app
# Production: Use secure passwords and proper hostnames (NO localhost)
DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/app

# Secret Key (REQUIRED)
# Generate a secure key for production: openssl rand -hex 32
# Development: dev-secret-key-change-in-production (will be rejected in production)
# Production: MUST use a secure, randomly generated key
SECRET_KEY=dev-secret-key-change-in-production

# === OPTIONAL SETTINGS ===

# Application Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=9001
DEBUG=false

# CORS Configuration (REQUIRED for production, optional for development)
# Development: http://localhost:9000 (default)
# Production: Set specific allowed origins, comma-separated
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:9000

# Database Pool Settings (optional - overrides defaults)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Version Control (optional - for app info endpoints)
BACKEND_VERSION=
COMMIT_REF=

# === SECURITY NOTES ===
# 1. NEVER use the default secret key in production
# 2. NEVER use localhost in database URLs in production
# 3. ALWAYS set specific CORS origins in production
# 4. Database credentials should be secure in production
