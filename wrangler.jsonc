{
  // 404less — self-hostable broken-link monitoring on Cloudflare free tier.
  // database_id is intentionally omitted: the "Deploy to Cloudflare" button
  // provisions D1 in the target account. For manual setup run:
  //   npx wrangler d1 create 404less   (then paste the id here)
  "name": "404less",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "404less",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/embed.js", "/mcp"]
  },
  "queues": {
    "producers": [
      { "binding": "CRAWLQ", "queue": "404less-crawl" }
    ],
    "consumers": [
      { "binding": "CRAWLQ", "queue": "404less-crawl", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 2 }
    ]
  },
  "triggers": {
    "crons": [ "*/30 * * * *" ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIGEST", "class_name": "DigestDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DigestDO"] }
  ]
}
