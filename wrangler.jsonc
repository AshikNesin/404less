{
  // 404less: self-hostable broken-link monitoring on Cloudflare free tier.
  // database_id is intentionally omitted: the "Deploy to Cloudflare" button
  // provisions D1 in the target account. For manual setup run:
  //   pnpm exec wrangler d1 create 404less   (then paste the id here)
  // Migrations apply on the first request after a deploy (apps/web/drizzle,
  // see apps/web/src/server/worker/boot.ts); no separate migrate step.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "404less",
  "main": "apps/web/src/server/entry.worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Drizzle's .sql migrations are bundled as text and applied on first request.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "404less",
      "database_id": "2a4ef659-f6f7-4fc9-ab15-82435f5d76ef",
      "migrations_dir": "apps/web/drizzle",
    },
  ],
  "assets": {
    // pnpm build:client → the SPA (app.html) + the marketing site (site/build.mjs)
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    // /__scheduled lets `wrangler dev --test-scheduled` fire the cron handler.
    // Every request hits the Worker first so entry.worker.ts can 301 http→https
    // and www.404less.com→404less.com before the asset cache answers. The Worker
    // then serves the file from this binding (worker/static-assets.ts).
    "run_worker_first": true,
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "404less.com", "custom_domain": true },
    { "pattern": "www.404less.com", "custom_domain": true },
  ],
  // The crawl tick every minute (crawling and title fetching, budgeted per tick;
  // an idle tick only reads), retention nightly. No Queues: see
  // apps/web/src/server/api/crawl/crawl.tick.ts.
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIGEST", "class_name": "DigestDO" },
      { "name": "RATELIMIT", "class_name": "RateLimiterDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DigestDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiterDO"] },
  ],
  // Non-secret configuration. groot's production checks want JWT_SECRET_KEY,
  // ADMIN_AUTH_KEY, ORIGIN and RP_ID; 404less fills them in when unset (see
  // worker/boot.ts), so a fresh deploy needs no secrets. Optional vars:
  // MAX_SITES_PER_TEAM, CRAWL_INTERVAL_HOURS (default 24), EVENT_RETENTION_DAYS,
  // MAIL_FROM; secret RESEND_API_KEY.
  // Optional marketing-site config. Leave unset to keep analytics off and the
  // 404 demo on the built-in site key. Do not commit real ids. See README.
  //   UMAMI_WEBSITE_ID   Umami website id (script: UMAMI_SRC, default https://hi.nesin.io/script.js)
  //   POSTHOG_KEY        PostHog project key (host: POSTHOG_HOST, default https://us.i.posthog.com)
  //   MARKETING_SITE_KEY real site key for the marketing 404 embed
  "vars": {
    "NODE_ENV": "production",
  },

  // Preview deploys (Workers Builds on non-production branches) get no bindings:
  // they prove the branch builds and uploads, without touching the production
  // D1. Opening a preview URL fails at boot (no DB) by design. For
  // working previews, point this block at test resources, never production ones.
  "previews": {},
}
