{
  "name": "404less",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable broken-link monitoring on Cloudflare free tier",
  "keywords": [],
  "homepage": "https://github.com/AshikNesin/404less#readme",
  "bugs": {
    "url": "https://github.com/AshikNesin/404less/issues"
  },
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshikNesin/404less.git"
  },
  "type": "module",
  "main": "dist/server/bundle.js",
  "scripts": {
    "dev": "NODE_ENV=development PORTLESS_PORT=8888 portless run --name $npm_package_name tsx scripts/dev.ts",
    "build": "rm -rf dist && vp build && node scripts/build.mjs",
    "start": "NODE_ENV=production node dist/server/bundle.js",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "typecheck:client": "tsc --noEmit -p apps/web",
    "typecheck:kit": "tsc --noEmit -p tests/kit-consumers",
    "check:closure": "node scripts/check-runtime-closure.mjs",
    "check:coverage": "tsx scripts/check-checks-coverage.ts",
    "test": "NODE_ENV=test vp test run --config vitest.config.server.ts",
    "test:client": "vp test run",
    "test:all": "pnpm test && pnpm test:client && pnpm test:worker",
    "test:watch": "NODE_ENV=test vp test --config vitest.config.server.ts",
    "test:e2e": "PORTLESS=0 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare": "vp config || [ ! -x node_modules/.bin/vp ]",
    "groot:setup": "bash .groot/setup-boilerplate.sh",
    "groot:check": "tsx .groot/sync.ts check",
    "groot:sync": "tsx .groot/sync.ts apply",
    "groot:resolve": "tsx .groot/resolve.ts",
    "groot:upstream": "tsx .groot/upstream.ts",
    "changeset": "changeset",
    "check:changesets": "node scripts/check-changesets.mjs",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "doctor": "pnpm dlx react-doctor@latest",
    "dev:worker": "pnpm build:client && wrangler dev",
    "build:client": "vp build && node site/build.mjs",
    "deploy:worker": "pnpm build:client && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir tmp/worker-build",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate:worker": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "test:worker": "vitest run --config vitest.config.worker.ts",
    "build:site": "node site/build.mjs",
    "build:og": "node site/og/render.mjs",
    "build:cf": "pnpm build:client",
    "deploy": "pnpm deploy:worker"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^1.19.0",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/cloudflare": "^10.0.0",
    "@sentry/node": "^10.63.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@uiw/react-codemirror": "^4.25.10",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "console-feed": "^3.8.0",
    "croner": "^10.0.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.23.0",
    "ms": "2.1.3",
    "nuqs": "^2.9.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@playwright/test": "^1.61.1",
    "@sentry/esbuild-plugin": "^5.3.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "baseline-browser-mapping": "^2.10.41",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "micromatch": "^4.0.8",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
